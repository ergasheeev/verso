# In an npm-workspaces monorepo, only the ROOT .npmrc is honored — a
# per-workspace .npmrc (e.g. backend/.npmrc) is silently ignored ("ignoring
# workspace config" warning). This must live here for Render's build
# (which sets NODE_ENV=production before `npm install`, causing npm to
# omit devDependencies — breaking the TypeScript build in backend) to work.
production=false
